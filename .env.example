# Pi Hub 环境变量样例 —— 复制为 .env 并填入真实值（.env 不进 git）
#
# 凭证类（企微智能机器人 · 长连接 API 模式）
WECOM_CORP_ID=
WECOM_BOT_ID=
WECOM_BOT_SECRET=
#
# ── ★ 必填：小电视（ESP32）的局域网 IP ──
# 企微控制/指令靠它找到设备。不填 ⇒ 屏幕能显示数据，但"发指令"必然失败
# （表现：企微回 "执行失败（ESP32 返回 502）"）。
# ⚠️ 当前固件【不会】自动上报自己的 IP，必须在这里手工填一次。
smalltv_ip=
#
# 可选覆盖项（一般无需设置，默认值已够用）
# 数据库路径（默认 <project>/data/pihub.db）
#PIHUB_DB=/home/pi/cooperate/pihub/data/pihub.db
# devctl 访问 Flask 的地址（默认优先 127.0.0.1 回环，换 IP/换段免疫）
#PIHUB_API_HOST=127.0.0.1
#
# 说明：mqtt_host / mqtt_port / pihub_port / smalltv_ip / pihub_host_remote /
# wecom_chat_id / wecom_chat_type 等运行期配置存在 SQLite config 表
# （优先级：环境变量 > .env > SQLite config 表 > 代码默认值）。
# 可在服务运行后用 `python3 app/config.py` 查看当前生效值。
