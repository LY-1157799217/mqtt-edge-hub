[Unit]
Description=Pi Hub 监控线程 (行情轮询 + 涨跌停/异动告警)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/cooperate/pihub/app
Environment=PYTHONUNBUFFERED=1
Environment=PIHUB_DB=/home/pi/cooperate/pihub/data/pihub.db
ExecStart=/home/pi/cooperate/pihub/.venv/bin/python /home/pi/cooperate/pihub/app/monitor.py
Restart=always
RestartSec=5
StandardOutput=append:/home/pi/cooperate/pihub/logs/monitor.log
StandardError=append:/home/pi/cooperate/pihub/logs/monitor.log

[Install]
WantedBy=multi-user.target
