[Unit]
Description=Pi Hub 设备控制器 (MQTT hub/command/smalltv -> ESP32 /set)
After=network-online.target mosquitto.service pihub-api.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/cooperate/pihub/app
Environment=PYTHONUNBUFFERED=1
Environment=PIHUB_DB=/home/pi/cooperate/pihub/data/pihub.db
ExecStart=/home/pi/cooperate/pihub/.venv/bin/python /home/pi/cooperate/pihub/app/devctl.py
Restart=always
RestartSec=5
StandardOutput=append:/home/pi/cooperate/pihub/logs/devctl.log
StandardError=append:/home/pi/cooperate/pihub/logs/devctl.log

[Install]
WantedBy=multi-user.target
